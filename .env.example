# Copy to .env and fill in your key. Never commit .env.
DEEPSEEK_API_KEY=
# Optional aliases (either DEEPSEEK_API_KEY or API_KEY works)
# API_KEY=

BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash
# Provider HTTP timeout (seconds). Raise if long tool-using turns hit TypeError/network drops.
# LLM_TIMEOUT_SEC=120

# Agent defaults (can also be overridden by CLI flags)
MAX_STEPS=30
MAX_MESSAGES=40
# ACON-style Context Manager token budget (approx; chars/4)
CONTEXT_TOKEN_BUDGET=32000
# Cost-A: cumulative task token hard cap across the whole run (0 = disabled)
# MAX_TASK_TOKENS=0
# TASK_TOKEN_OUTPUT_RESERVE=512
# Soft warn when remaining ≤ this fraction of task tokens or steps (Cost-B)
# TASK_BUDGET_WARN_RATIO=0.20
WORKDIR=.
APPROVAL=auto
# Loop guard / action dedup (identical tool+args)
# LOOP_WARN_AFTER=3
# LOOP_STOP_AFTER=5
# LOOP_ERROR_NUDGE_AFTER=2
# RETRY_MAX_FAILURES=3
# E3: limited auto-retry for API/429/timeout/lock (not for strategy failures)
# TRANSIENT_RETRY_MAX=2
# TRANSIENT_RETRY_BACKOFF_MS=200
# FINAL_NUDGE_MUTATING_LIMIT=2
# TOOL_VISIBILITY=auto
# COMPLETION_MODE=evidence
# EVIDENCE_NUDGE_MAX=2
# FAKE_GREEN_MODE=block
# NETWORK_POLICY=high
# DENY_HIGH=false
# S5: shell prefix gate — open (default) | allowlist
# SHELL_MODE=open
# SHELL_ALLOWLIST=pytest,python,python3,py,git
# X2: structured episodes (.agent/episodes.jsonl); 1=on (default)
# EPISODE_MEMORY=1
# EPISODE_RECALL_MAX=3
# Auto TF–IDF RAG into Current State at run start; 1=on (default)
# RAG_PREFETCH=1
# RAG_PREFETCH_MAX_CHARS=600
# TRANSCRIPT_DIR=transcripts
# TRANSCRIPT_DIR=off
